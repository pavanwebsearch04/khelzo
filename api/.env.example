APP_NAME=KHELZO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database (MySQL) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=khelzo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---- Storefront / CORS ----
# Comma-separated origins allowed to call the API (no trailing slash).
FRONTEND_URL=http://localhost:3000
# Public storefront URL used in email links (defaults to the first FRONTEND_URL).
FRONTEND_URL_PUBLIC=

# ---- Admin account created by `php artisan db:seed` ----
# REQUIRED in production. The seeder never resets an existing admin's password.
ADMIN_EMAIL=admin@khelzo.local
ADMIN_PASSWORD=ChangeMe!2026

# ---- Payments (Razorpay). Use TEST keys until you go live. ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → URL: {APP_URL}/api/webhooks/razorpay, events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (order confirmations, shipping updates, password reset, cart reminders) ----
# "log" only writes emails to storage/logs. Use smtp (or resend/ses/postmark) in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Product images ----
# "public" stores on this server (php artisan storage:link). For production use an S3-compatible disk:
#   composer require league/flysystem-aws-s3-v3 "^3.0"   then set UPLOAD_DISK=s3 and the AWS_* values below
#   (AWS_ENDPOINT + AWS_URL work for Cloudflare R2 / DigitalOcean Spaces).
UPLOAD_DISK=public
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Courier serviceability (optional) ----
# With these set, the PIN-code checker asks Shiprocket; without them it only applies the PIN block-list from Admin → Settings.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=

VITE_APP_NAME="${APP_NAME}"
