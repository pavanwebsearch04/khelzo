# Storefront (Next.js) environment. Copy to .env.local and adjust.

# Laravel API base URL (must end with /api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public origin of this storefront: canonical URLs, Open Graph, sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact details shown in the footer and policy pages
NEXT_PUBLIC_SUPPORT_EMAIL=hello@khelzo.example
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_NAME=KHELZO

# Optional analytics — loaded only after the visitor accepts the cookie banner
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Extra hostnames allowed for product images (S3/R2/CDN), comma separated
NEXT_PUBLIC_IMAGE_HOSTS=
